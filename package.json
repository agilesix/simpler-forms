{
  "name": "simpler-forms",
  "version": "0.2.0",
  "description": "A TypeSpec library for specifying forms once and emitting portable form artifacts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilesix/simpler-forms.git"
  },
  "homepage": "https://github.com/agilesix/simpler-forms#readme",
  "bugs": "https://github.com/agilesix/simpler-forms/issues",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "src",
    "lib",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write . && tsp format \"lib/**/*.tsp\"",
    "check:format": "prettier --check . && tsp format --check \"lib/**/*.tsp\"",
    "check:types": "tsc -p . --noEmit",
    "checks": "pnpm check:format && pnpm lint && pnpm check:types && pnpm test"
  },
  "peerDependencies": {
    "@typespec/compiler": "^1.16.0",
    "@typespec/json-schema": "^1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typespec/compiler": "^1.18.0",
    "@typespec/json-schema": "^1.18.0",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
